page {
  min-height: 100%;
  background: #f3f7f1;
  color: #1f2d23;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button::after {
  border: none;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid #dce8dd;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 30rpx rgba(47, 107, 69, 0.06);
}

.primary-button {
  height: 92rpx;
  border-radius: 46rpx;
  background: #2f6b45;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.primary-button[disabled] {
  background: #aebcaf;
  color: #edf1ed;
}

.muted {
  color: #718076;
}

